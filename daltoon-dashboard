                        DASH_PORT=${DASH_PORT:-3000}

                        echo -e "${GREEN}====================================================${NC}"
                        if [ "$DASH_PORT" == "443" ]; then
                            echo -e "${GREEN}• Domain Access URL: https://$ssl_dom${NC}"
                        else
                            echo -e "${GREEN}• Domain Access URL: https://$ssl_dom:$DASH_PORT${NC}"
                        fi
                        echo -e "${GREEN}• Server IP Access URL: http://${SERVER_IP:-IP}:$DASH_PORT${NC}"
                        echo -e "${GREEN}====================================================${NC}"

                        pm2 restart daltoon-store >/dev/null 2>&1 || pm2 start daltoon-store >/dev/null 2>&1
                    else
                        echo -e "${RED}acme.sh failed to install certificate for $ssl_dom.${NC}"
                        pm2 start daltoon-store 2>/dev/null || true
                    fi
                else
                    echo -e "${RED}acme.sh failed to issue certificate for $ssl_dom. Please check logs.${NC}"
                    rm -rf ~/.acme.sh/${ssl_dom} ~/.acme.sh/${ssl_dom}_ecc
                    pm2 start daltoon-store 2>/dev/null || true
                fi
                read -p "Press enter to continue..."
                ;;
            2)
                read -p "Enter domain to revoke & remove (leave empty for ALL): " del_dom
                del_dom=$(echo "$del_dom" | tr -d ' ' | tr '[:upper:]' '[:lower:]')
                read -p "Are you sure you want to revoke and delete SSL certificate(s)? (y/n): " confirm_del
                if [[ $confirm_del == "y" || $confirm_del == "Y" ]]; then
                    if [[ -n "$del_dom" ]]; then
                        echo -e "${YELLOW}Revoking SSL certificate for $del_dom...${NC}"
                        if command -v ~/.acme.sh/acme.sh &> /dev/null; then
                            ~/.acme.sh/acme.sh --revoke -d "$del_dom" 2>/dev/null || true
                            ~/.acme.sh/acme.sh --remove -d "$del_dom" 2>/dev/null || true
                        fi
                        rm -rf "/root/cert/$del_dom" 2>/dev/null || true
                        rm -rf ~/.acme.sh/"${del_dom}"* 2>/dev/null || true
                    else
