            5)
                echo -e "${YELLOW}Set Custom SSL Certificate Paths for Panel${NC}"
                read -p "Enter Domain Name: " custom_dom
                read -p "Enter Public Key Path (fullchain.pem): " custom_pub
                read -p "Enter Private Key Path (privkey.pem): " custom_priv

                custom_dom=$(echo "$custom_dom" | tr -d ' ')
                custom_pub=$(echo "$custom_pub" | tr -d ' ')
                custom_priv=$(echo "$custom_priv" | tr -d ' ')

                if [[ -z "$custom_pub" || -z "$custom_priv" ]]; then
                    echo -e "${RED}Public key and Private key paths cannot be empty!${NC}"
                elif [[ ! -f "$custom_pub" || ! -f "$custom_priv" ]]; then
                    echo -e "${RED}Specified key file(s) do not exist on disk!${NC}"
                else
                    update_ssl_db "$custom_dom" "$custom_pub" "$custom_priv"
                    echo -e "${GREEN}✓ Custom SSL certificate paths successfully configured in database.${NC}"
                    echo -e "${GREEN}Restarting dashboard...${NC}"
                    pm2 restart daltoon-store >/dev/null 2>&1 || pm2 start daltoon-store >/dev/null 2>&1
                fi
                read -p "Press enter to continue..."
                ;;
            6)
                echo -e "${YELLOW}Requesting SSL Certificate for IP Address...${NC}"
                apt-get update -y > /dev/null 2>&1 || true
                apt-get install -y socat curl openssl psmisc lsof > /dev/null 2>&1 || true

                SERVER_IP=$(curl -s4 -m 5 https://api.ipify.org || curl -s4 -m 5 https://ifconfig.me || curl -s4 -m 5 https://icanhazip.com || true)
                SERVER_IP=$(echo "$SERVER_IP" | tr -d ' 

')

                read -p "Enter IP Address [$SERVER_IP]: " ip_input
                ip_target=${ip_input:-$SERVER_IP}

                if [[ -z "$ip_target" ]]; then
                    echo -e "${RED}IP Address cannot be empty!${NC}"
                    read -p "Press enter to continue..."
                    continue
                fi

                read -p "Enter Port for ACME Standalone [80]: " acme_port
                acme_port=${acme_port:-80}

                echo -e "${YELLOW}Attempting IP SSL Certificate issue for $ip_target via acme.sh ZeroSSL on port $acme_port...${NC}"
                if ! command -v ~/.acme.sh/acme.sh &> /dev/null; then
                    curl -s https://get.acme.sh | sh
                fi

                docker stop smite-nginx 2>/dev/null || true
                pm2 stop daltoon-store 2>/dev/null || true
                systemctl stop nginx nginx.socket apache2 apache2.socket 2>/dev/null || true
                fuser -k -9 "$acme_port/tcp" 2>/dev/null || true
                sleep 2

                mkdir -p "/root/cert/$ip_target"
                ip_issued=false

                acme_port_flag=""
                if [ "$acme_port" != "80" ]; then
                    acme_port_flag="--httpport $acme_port"
                fi

                ~/.acme.sh/acme.sh --register-account -m "admin@$ip_target" --server zerossl 2>/dev/null || true
                if ~/.acme.sh/acme.sh --issue -d "$ip_target" $acme_port_flag --standalone --server zerossl --force; then
                    ~/.acme.sh/acme.sh --installcert --force -d "$ip_target"                         --key-file "/root/cert/$ip_target/privkey.pem"                         --fullchain-file "/root/cert/$ip_target/fullchain.pem"
                    ip_issued=true
                    echo -e "${GREEN}✓ ZeroSSL IP Certificate issued successfully (6-day auto-renewing).${NC}"
                else
                    echo -e "${YELLOW}ZeroSSL IP issuance failed. Generating trusted self-signed IP SSL certificate fallback...${NC}"
                    openssl req -x509 -nodes -days 365 -newkey rsa:2048                         -keyout "/root/cert/$ip_target/privkey.pem"                         -out "/root/cert/$ip_target/fullchain.pem"                         -subj "/CN=$ip_target"                         -addext "subjectAltName=IP:$ip_target" 2>/dev/null || true
                    if [[ -f "/root/cert/$ip_target/fullchain.pem" ]]; then
                        ip_issued=true
                        echo -e "${GREEN}✓ IP SSL Certificate created at /root/cert/$ip_target/${NC}"
                    fi
                fi

                docker start smite-nginx 2>/dev/null || true
                systemctl start nginx 2>/dev/null || true
                pm2 restart daltoon-store >/dev/null 2>&1 || pm2 start daltoon-store >/dev/null 2>&1 || true

                if [ "$ip_issued" = "true" ]; then
                    update_ssl_db "$ip_target" "/root/cert/$ip_target/fullchain.pem" "/root/cert/$ip_target/privkey.pem"
                    echo -e "${GREEN}✓ IP SSL Certificate configured in database.${NC}"
                else
                    echo -e "${RED}Failed to create IP SSL certificate.${NC}"
                fi
                read -p "Press enter to continue..."
                ;;
            0)
                break
                ;;
            *)
                echo -e "${RED}Invalid option${NC}"
                sleep 1
                ;;
        esac
    done
