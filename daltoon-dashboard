}

update_db() {
    local key=$1
    local val=$2
    local is_int=$3
    
    python3 -c "
import os, json, sqlite3

install_dir = os.environ.get('INSTALL_DIR', '/opt/daltoon-store')
key = '$key'
val = '$val'
if '$is_int' == 'true':
    try: val = int(val)
    except: pass

# 1. Update JSON if exists
json_path = os.path.join(install_dir, 'Daltoon_Bot.json')
if os.path.exists(json_path):
    try:
        with open(json_path, 'r', encoding='utf-8') as f:
            data = json.load(f)
        if 'settings' not in data: data['settings'] = {}
        if key == 'port': data['settings']['serverPort'] = val
        elif key == 'user': data['settings']['dashboardUsername'] = val
        elif key == 'pass': data['settings']['dashboardPassword'] = val
        
        if 'panel_config' in data['settings']:
            try:
                pc = data['settings']['panel_config']
                if isinstance(pc, str): pc = json.loads(pc)
                if key == 'port': pc['serverPort'] = val
                elif key == 'user': pc['dashboardUsername'] = val
                elif key == 'pass': pc['dashboardPassword'] = val
                data['settings']['panel_config'] = json.dumps(pc)
            except Exception: pass
        with open(json_path, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
    except Exception: pass

# 2. Update SQLite if exists
db_path = os.path.join(install_dir, 'Daltoon_Bot.db')
if os.path.exists(db_path):
    try:
        conn = sqlite3.connect(db_path)
        cur = conn.cursor()
        cur.execute(\"SELECT value FROM kv WHERE key = 'settings'\")
        row = cur.fetchone()
        if row:
            settings = json.loads(row[0])
            if key == 'port': settings['serverPort'] = val
            elif key == 'user': settings['dashboardUsername'] = val
            elif key == 'pass': settings['dashboardPassword'] = val
            if 'panel_config' in settings:
                try:
                    pc = settings['panel_config']
                    if isinstance(pc, str): pc = json.loads(pc)
                    if key == 'port': pc['serverPort'] = val
                    elif key == 'user': pc['dashboardUsername'] = val
                    elif key == 'pass': pc['dashboardPassword'] = val
                    settings['panel_config'] = json.dumps(pc)
                except Exception: pass
            cur.execute(\"UPDATE kv SET value = ? WHERE key = 'settings'\", (json.dumps(settings, ensure_ascii=False),))
            conn.commit()
        conn.close()
    except Exception as e:
        print('SQLite Update Error:', e)
"
}

update_ssl_db() {
    local domain=$1
    local pub_key=$2
    local priv_key=$3
    
    python3 -c "
import os, json, sqlite3

install_dir = os.environ.get('INSTALL_DIR', '/opt/daltoon-store')
domain = '$domain'
pub_key = '$pub_key'
priv_key = '$priv_key'

# 1. Update JSON if exists
json_path = os.path.join(install_dir, 'Daltoon_Bot.json')
if os.path.exists(json_path):
    try:
        with open(json_path, 'r', encoding='utf-8') as f:
            data = json.load(f)
        if 'settings' not in data: data['settings'] = {}
        data['settings']['domainName'] = domain
        data['settings']['sslPublicKeyPath'] = pub_key
        data['settings']['sslPrivateKeyPath'] = priv_key
        pc = {}
        if 'panel_config' in data['settings']:
            try:
                raw_pc = data['settings']['panel_config']
                pc = json.loads(raw_pc) if isinstance(raw_pc, str) else raw_pc
            except Exception: pass
        pc['domainName'] = domain
        pc['sslPublicKeyPath'] = pub_key
        pc['sslPrivateKeyPath'] = priv_key
        pc['sslAutoRenewal'] = False
        pc['sslCertificateStatus'] = 'active' if (pub_key and priv_key) else 'not_configured'
        data['settings']['panel_config'] = json.dumps(pc)
        with open(json_path, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
    except Exception: pass

# 2. Update SQLite if exists
db_path = os.path.join(install_dir, 'Daltoon_Bot.db')
if os.path.exists(db_path):
    try:
        conn = sqlite3.connect(db_path)
        cur = conn.cursor()
        cur.execute(\"SELECT value FROM kv WHERE key = 'settings'\")
        row = cur.fetchone()
        settings = json.loads(row[0]) if row else {}
        settings['domainName'] = domain
        settings['sslPublicKeyPath'] = pub_key
        settings['sslPrivateKeyPath'] = priv_key
        pc = {}
        if 'panel_config' in settings:
            try:
                raw_pc = settings['panel_config']
                pc = json.loads(raw_pc) if isinstance(raw_pc, str) else raw_pc
            except Exception: pass
        pc['domainName'] = domain
        pc['sslPublicKeyPath'] = pub_key
        pc['sslPrivateKeyPath'] = priv_key
        pc['sslAutoRenewal'] = False
        pc['sslCertificateStatus'] = 'active' if (pub_key and priv_key) else 'not_configured'
        settings['panel_config'] = json.dumps(pc)
        cur.execute(\"INSERT OR REPLACE INTO kv (key, value) VALUES ('settings', ?)\", (json.dumps(settings, ensure_ascii=False),))
        conn.commit()
        conn.close()
    except Exception as e:
        print('SQLite SSL Update Error:', e)
"
}

ssl_menu() {
    while true; do
        clear
        echo -e "${BLUE}====================================================${NC}"
        echo -e "${BLUE}         SSL Certificate Management                ${NC}"
        echo -e "${BLUE}====================================================${NC}"
        echo -e "1. Get SSL (Domain)"
        echo -e "2. Revoke & Remove"
        echo -e "3. Force Renew"
        echo -e "4. Show Existing Domains"
        echo -e "5. Set Cert paths for the panel"
        echo -e "6. Get SSL for IP Address (6-day cert, auto-renews)"
        echo -e "0. Back to Main Menu"
        echo -e "${BLUE}====================================================${NC}"
        read -p "Choose an option: " ssl_opt
        case $ssl_opt in
            1)
                echo -e "${YELLOW}Installing dependencies (socat, curl, openssl, dnsutils, psmisc, lsof, certbot)...${NC}"
                apt-get update -y > /dev/null 2>&1 || true
                apt-get install -y socat curl openssl dnsutils bind9-host psmisc lsof certbot > /dev/null 2>&1 || true

                read -p "Enter Domain Name: " ssl_dom
                ssl_dom=$(echo "$ssl_dom" | tr -d ' ' | tr '[:upper:]' '[:lower:]')
                if [[ -z "$ssl_dom" ]]; then
                    echo -e "${RED}Domain name cannot be empty!${NC}"
                    read -p "Press enter to continue..."
                    continue
                fi

                echo -e "${YELLOW}Verifying DNS resolution for $ssl_dom...${NC}"
                SERVER_IP=$(curl -s4 -m 5 https://api.ipify.org || curl -s4 -m 5 https://ifconfig.me || curl -s4 -m 5 https://icanhazip.com || true)
                SERVER_IP=$(echo "$SERVER_IP" | tr -d ' 

')

                DOMAIN_IP=$(dig +short +time=3 +tries=2 A "$ssl_dom" 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | tail -n1)
                if [[ -z "$DOMAIN_IP" ]]; then
                    DOMAIN_IP=$(getent ahosts "$ssl_dom" 2>/dev/null | awk '{print $1}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -n1)
                fi

                if [[ -z "$DOMAIN_IP" ]]; then
                    echo -e "${RED}⚠️ Error: Domain '$ssl_dom' does not resolve to any IP address!${NC}"
                    echo -e "${RED}Please add an A-Record for '$ssl_dom' pointing to your server IP (${SERVER_IP:-Unknown}) in your DNS provider.${NC}"
                    read -p "Do you want to force attempt issuing SSL anyway? (y/n): " force_dns
                    if [[ "$force_dns" != "y" && "$force_dns" != "Y" ]]; then
                        read -p "Press enter to continue..."
                        continue
                    fi
                elif [[ -n "$SERVER_IP" && "$DOMAIN_IP" != "$SERVER_IP" ]]; then
                    echo -e "${YELLOW}⚠️ Warning: Domain DNS IP ($DOMAIN_IP) does not match server IP ($SERVER_IP)!${NC}"
                    echo -e "${YELLOW}Note: If using Cloudflare, turn OFF proxy mode (set DNS to DNS-Only / Grey Cloud).${NC}"
                    read -p "Do you want to proceed with SSL issuance anyway? (y/n): " force_ip
                    if [[ "$force_ip" != "y" && "$force_ip" != "Y" ]]; then
                        read -p "Press enter to continue..."
                        continue
                    fi
                else
                    echo -e "${GREEN}✓ DNS verified: $ssl_dom points to server IP ($SERVER_IP).${NC}"
                fi

                if ! command -v ~/.acme.sh/acme.sh &> /dev/null; then
                    curl -s https://get.acme.sh | sh
                fi

                if ~/.acme.sh/acme.sh --list 2> /dev/null | awk '{print $1}' | grep -Fxq "$ssl_dom"; then
                    echo -e "${YELLOW}Cleaning up existing acme.sh state for $ssl_dom...${NC}"
                    rm -rf ~/.acme.sh/${ssl_dom} ~/.acme.sh/${ssl_dom}_ecc 2>/dev/null || true
                fi

                ~/.acme.sh/acme.sh --set-default-ca --server letsencrypt --force
                ssl_issued=false

                read -p "Enter Port for ACME Standalone [80]: " acme_port
                acme_port=${acme_port:-80}

                echo -e "${YELLOW}Stopping web services to free port $acme_port...${NC}"
                
                # Dynamic container detection to free port 80/acme_port
                stopped_containers=""
                if command -v docker >/dev/null 2>&1; then
                    # 1. Stop any container with nginx, x-ui, xui, marzban, 3x-ui in name
                    nginx_conts=$(docker ps --format '{{.Names}}' | grep -E -i 'nginx|x-ui|xui|marzban|3x-ui' || true)
                    for c in $nginx_conts; do
                        echo -e "${YELLOW}Stopping Docker container: $c...${NC}"
                        docker stop "$c" 2>/dev/null || true
                        stopped_containers="$stopped_containers $c"
                    done

                    # 2. Stop any other container binding to the selected acme_port
                    port_conts=$(docker ps --filter "publish=$acme_port" --format '{{.Names}}' || true)
                    for c in $port_conts; do
                        if [[ ! " $stopped_containers " =~ " $c " ]]; then
                            echo -e "${YELLOW}Stopping Docker container $c binding on port $acme_port...${NC}"
                            docker stop "$c" 2>/dev/null || true
                            stopped_containers="$stopped_containers $c"
                        fi
                    done
                fi

                # Build dynamic trap command to restore all stopped containers and services
                trap_cmd="systemctl start nginx 2>/dev/null || true; pm2 start daltoon-store 2>/dev/null || true; docker start smite-nginx 2>/dev/null || true"
                for c in $stopped_containers; do
                    trap_cmd="$trap_cmd; docker start $c 2>/dev/null || true"
                done
                trap "$trap_cmd" EXIT

                docker stop smite-nginx 2>/dev/null || true
                pm2 stop daltoon-store 2>/dev/null || true
                systemctl stop nginx nginx.socket apache2 apache2.socket 2>/dev/null || true
                pkill -9 -f nginx 2>/dev/null || true
                fuser -k -9 "$acme_port/tcp" 2>/dev/null || true
                sleep 2

                acme_listen_flag=""
                if ! ip -4 addr show scope global 2> /dev/null | grep -q "inet "; then
                    acme_listen_flag="--listen-v6"
                fi

                acme_port_flag=""
                if [ "$acme_port" != "80" ]; then
                    acme_port_flag="--httpport $acme_port"
                fi

                echo -e "${YELLOW}Requesting SSL Certificate (EC-256) on port $acme_port...${NC}"
                ~/.acme.sh/acme.sh --register-account -m "admin@$ssl_dom" --server letsencrypt 2>/dev/null || true
                ~/.acme.sh/acme.sh --set-default-ca --server letsencrypt 2>/dev/null || true
                if ~/.acme.sh/acme.sh --issue -d "$ssl_dom" $acme_listen_flag $acme_port_flag --standalone --server letsencrypt -k ec-256 --force; then
                    ssl_issued=true
                    echo -e "${GREEN}✓ SSL Certificate issued successfully via Let's Encrypt.${NC}"
                else
                    echo -e "${YELLOW}⚠️ Let's Encrypt failed. Retrying with Buypass CA...${NC}"
                    ~/.acme.sh/acme.sh --register-account -m "admin@$ssl_dom" --server buypass 2>/dev/null || true
                    if ~/.acme.sh/acme.sh --issue -d "$ssl_dom" $acme_listen_flag $acme_port_flag --standalone --server buypass -k ec-256 --force; then
                        ssl_issued=true
                        echo -e "${GREEN}✓ SSL Certificate issued successfully via Buypass.${NC}"
                    else
                        echo -e "${YELLOW}⚠️ Buypass failed. Retrying with ZeroSSL...${NC}"
                        ~/.acme.sh/acme.sh --register-account -m "admin@$ssl_dom" --server zerossl 2>/dev/null || true
                        if ~/.acme.sh/acme.sh --issue -d "$ssl_dom" $acme_listen_flag $acme_port_flag --standalone --server zerossl -k ec-256 --force; then
                            ssl_issued=true
                            echo -e "${GREEN}✓ SSL Certificate issued successfully via ZeroSSL.${NC}"
                        else
                            echo -e "${YELLOW}⚠️ ZeroSSL failed. Retrying with Certbot...${NC}"
                            if certbot certonly --standalone -d "$ssl_dom" --non-interactive --agree-tos -m "admin@$ssl_dom" --http-01-port $acme_port --force-renewal; then
                                mkdir -p "/root/cert/$ssl_dom"
                                cp -f "/etc/letsencrypt/live/$ssl_dom/fullchain.pem" "/root/cert/$ssl_dom/fullchain.pem" 2>/dev/null || true
                                cp -f "/etc/letsencrypt/live/$ssl_dom/privkey.pem" "/root/cert/$ssl_dom/privkey.pem" 2>/dev/null || true
                                if [[ -f "/root/cert/$ssl_dom/fullchain.pem" ]]; then
                                    ssl_issued=true
                                    echo -e "${GREEN}✓ SSL Certificate issued successfully via Certbot.${NC}"
                                fi
                            fi

                            if [ "$ssl_issued" != "true" ]; then
                                echo -e "${YELLOW}⚠️ Online CAs failed (Cloudflare Proxy / Port 80 blocked). Generating self-signed SSL fallback for $ssl_dom...${NC}"
                                echo -e "${YELLOW}📌 Note: If using Cloudflare, please set DNS Proxy to 'DNS-Only' (Grey Cloud ⚪) and retry SSL issuance!${NC}"
                                mkdir -p "/root/cert/$ssl_dom"
                                openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
                                    -keyout "/root/cert/$ssl_dom/privkey.pem" \
                                    -out "/root/cert/$ssl_dom/fullchain.pem" \
                                    -subj "/CN=$ssl_dom" \
                                    -addext "subjectAltName=DNS:$ssl_dom" 2>/dev/null || true
                                if [[ -f "/root/cert/$ssl_dom/fullchain.pem" ]]; then
                                    ssl_issued=true
                                    echo -e "${GREEN}✓ Self-signed SSL Certificate created at /root/cert/$ssl_dom/${NC}"
                                fi
                            fi
                        fi
                    fi
                fi

                trap - EXIT

                systemctl start nginx 2>/dev/null || true
                docker start smite-nginx 2>/dev/null || true
                for c in $stopped_containers; do
                    docker start "$c" 2>/dev/null || true
                done

                if [ "$ssl_issued" = "true" ]; then
                    mkdir -p "/root/cert/$ssl_dom"
                    if [ -f "$HOME/.acme.sh/${ssl_dom}_ecc/fullchain.cer" ] || [ -f "$HOME/.acme.sh/${ssl_dom}/fullchain.cer" ]; then
                        reload_conts=""
                        for c in $stopped_containers; do
                            if [[ "$c" =~ "nginx" ]]; then
                                reload_conts="$reload_conts; docker exec $c nginx -s reload 2>/dev/null || true"
                            fi
                        done
                        local ecc_flag=""
                        if [ -f "$HOME/.acme.sh/${ssl_dom}_ecc/fullchain.cer" ]; then
                            ecc_flag="--ecc"
                        fi
                        ~/.acme.sh/acme.sh --installcert --force -d "$ssl_dom" $ecc_flag \
                            --key-file "/root/cert/$ssl_dom/privkey.pem" \
                            --fullchain-file "/root/cert/$ssl_dom/fullchain.pem" \
                            --reloadcmd "docker exec smite-nginx nginx -s reload 2>/dev/null || true$reload_conts; pm2 restart daltoon-store || pm2 start daltoon-store" 2>/dev/null || true
                    fi
                    ~/.acme.sh/acme.sh --upgrade --auto-upgrade > /dev/null 2>&1 || true
                    pub_path="/root/cert/$ssl_dom/fullchain.pem"
                    priv_path="/root/cert/$ssl_dom/privkey.pem"

                    if [[ -f "$pub_path" && -f "$priv_path" ]]; then
                        echo -e "${GREEN}[INF] Panel paths set for domain: $ssl_dom${NC}"
                        echo -e "${GREEN}[INF] - Certificate File: $pub_path${NC}"
                        echo -e "${GREEN}[INF] - Private Key File: $priv_path${NC}"

                        update_ssl_db "$ssl_dom" "$pub_path" "$priv_path"

                        DASH_PORT=$(python3 -c "
import os, json, sqlite3
install_dir = os.environ.get('INSTALL_DIR', '$INSTALL_DIR')
port = 3000
try:
    jp = os.path.join(install_dir, 'Daltoon_Bot.json')
    if os.path.exists(jp):
        with open(jp) as f:
            d = json.load(f)
            if 'settings' in d:
                s = d['settings']
                port = s.get('serverPort') or s.get('port') or port
                pc = s.get('panel_config')
                if pc:
                    if isinstance(pc, str): pc = json.loads(pc)
                    port = pc.get('serverPort') or pc.get('port') or port
except Exception: pass

try:
    dp = os.path.join(install_dir, 'Daltoon_Bot.db')
    if os.path.exists(dp):
        conn = sqlite3.connect(dp)
        cur = conn.cursor()
        cur.execute(\"SELECT value FROM kv WHERE key = 'settings'\")
        r = cur.fetchone()
        if r:
            s = json.loads(r[0])
            port = s.get('serverPort') or s.get('port') or port
